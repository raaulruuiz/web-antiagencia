{
  "crons": [
    { "path": "/api/anti-studio-latido", "schedule": "0 7 */2 * *" }
  ],
  "redirects": [
    { "source": "/newsletter", "destination": "/", "permanent": false },
    { "source": "/facebook-instagram", "destination": "/", "permanent": true },
    { "source": "/facebook-instagram/", "destination": "/", "permanent": true },
    { "source": "/anti-newsletter", "destination": "/", "permanent": true },
    { "source": "/anti-newsletter/", "destination": "/", "permanent": true },
    { "source": "/PoliticaPrivacidad", "destination": "/politica-privacidad", "permanent": true },
    { "source": "/r", "destination": "/", "permanent": true },
    { "source": "/r/", "destination": "/", "permanent": true }
  ],
  "headers": [
    { "source": "/pruebas", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }] },
    { "source": "/pruebas/", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }] }
  ],
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
